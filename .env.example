# ====================================================================
# GLAMORA FASHION STORE - ENVIRONMENT VARIABLES CONFIGURATION
# ====================================================================
# Copy this file or add these environment variables in your Vercel Project Settings:
# Settings -> Environment Variables

# Node Environment
NODE_ENV=production

# Server Port (used for local development; Vercel sets this automatically)
PORT=5000

# --------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# --------------------------------------------------------------------
# Replace with your MongoDB Atlas connection string:
# 1. Create a free M0 cluster at https://cloud.mongodb.com
# 2. Add Network Access: 0.0.0.0/0 (allow all IPs, required for Vercel)
# 3. Create database user and password
# 4. Copy the SRV URI below:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.your_cluster_id.mongodb.net/fashionstore?retryWrites=true&w=majority

# --------------------------------------------------------------------
# 2. AUTHENTICATION & SESSIONS
# --------------------------------------------------------------------
# Any strong random secret key (e.g. openssl rand -base64 32)
JWT_SECRET=fashionstore_super_secret_jwt_key_2026
SESSION_SECRET=fashionstore_super_secret_session_key_2026

# --------------------------------------------------------------------
# 3. CLOUD STORAGE (Supabase - for product image uploads)
# --------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_service_key
SUPABASE_BUCKET=glamora

# --------------------------------------------------------------------
# 4. AI ASSISTANT (Google Gemini API)
# --------------------------------------------------------------------
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------------
# 5. FRONTEND & CORS CONFIGURATION
# --------------------------------------------------------------------
# Comma-separated list of allowed origins.
# (Vercel deployment URLs like *.vercel.app are automatically allowed)
CLIENT_URL=http://localhost:3000,https://your-app.vercel.app

# Optional for Frontend: only needed if backend is hosted on a separate custom domain
# If left unset on a unified Vercel deployment, frontend uses same-domain relative /api
# REACT_APP_API_URL=https://your-app.vercel.app

