<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Database · Glamora Admin</title>
  <%- include('../partials/head') %>
  <style>
    .collections { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; margin-bottom: 16px; }
    .collection { text-align: left; padding: 14px 16px; cursor: pointer; border: 1px solid var(--border); transition: border-color 0.15s, background 0.15s; }
    .collection:hover { border-color: var(--border-strong); }
    .collection.active { border-color: var(--brand); background: var(--brand-tint); }
    .collection .name { font-size: 13px; color: var(--text-muted); font-weight: 500; }
    .collection .mono { font-size: 13px; color: var(--text); }
    .collection .count { font-size: 22px; font-weight: 600; margin-top: 4px; }
    .panel[hidden] { display: none; }
    .table td { white-space: nowrap; max-width: 240px; overflow: hidden; text-overflow: ellipsis; }
    .id { color: var(--text-faint); }
    .thumb { width: 30px; height: 30px; border-radius: 5px; object-fit: cover; border: 1px solid var(--border); vertical-align: middle; }
    .rel-diagram { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; padding: 24px; background: var(--surface-muted); border-bottom: 1px solid var(--border); }
    .entity { background: var(--surface); border: 1px solid var(--border-strong); border-radius: var(--radius); min-width: 150px; overflow: hidden; }
    .entity h4 { font-size: 13px; font-weight: 600; padding: 8px 12px; background: var(--brand-tint); color: var(--brand); border-bottom: 1px solid var(--border); }
    .entity ul { list-style: none; padding: 8px 12px; font-size: 12px; color: var(--text-muted); }
    .entity li { padding: 2px 0; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    .entity li.key { color: var(--text); }
    .arrow { color: var(--text-faint); font-size: 12px; text-align: center; }
    @media (max-width: 1000px) { .collections { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 520px) { .collections { grid-template-columns: repeat(2, 1fr); } }
  </style>
</head>
<body>
<%
  const tabs = [
    { key: 'users', label: 'users', count: users.length },
    { key: 'products', label: 'products', count: products.length },
    { key: 'orders', label: 'orders', count: orders.length },
    { key: 'reviews', label: 'reviews', count: reviews.length },
    { key: 'analytics', label: 'analytics', count: analytics.length, note: 'latest 100' },
    { key: 'relations', label: 'relationships', count: 6 },
  ];
%>
<div class="dash-layout">
  <%- include('../partials/sidebar', { active: 'schema' }) %>
  <main class="dash-main">
    <div class="page">
      <%- include('../partials/topbar', { title: 'Database', subtitle: 'Live records from each MongoDB collection', admin: admin }) %>

      <div class="collections" role="tablist">
        <% tabs.forEach((t, i) => { %>
          <button class="card collection <%= i === 0 ? 'active' : '' %>" data-tab="<%= t.key %>" role="tab">
            <div class="mono"><%= t.label %></div>
            <div class="count num"><%= t.count %></div>
            <div class="name"><%= t.key === 'relations' ? 'links' : (t.note || 'documents') %></div>
          </button>
        <% }) %>
      </div>

      <!-- USERS -->
      <section class="card panel" id="panel-users">
        <div class="card-head"><h2 class="mono">users</h2><span class="muted"><%= users.length %> documents</span></div>
        <% if (!users.length) { %><div class="empty">No documents</div><% } else { %>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>_id</th><th>name</th><th>email</th><th>role</th><th>addresses</th><th>createdAt</th></tr></thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td class="mono id"><%= u._id %></td>
                <td class="cell-main"><%= u.name %></td>
                <td><%= u.email %></td>
                <td><span class="badge plain <%= u.role === 'admin' ? 'badge-brand' : '' %>"><%= u.role %></span></td>
                <td class="num"><%= u.addresses ? u.addresses.length : 0 %></td>
                <td class="muted"><%= formatDateTime(u.createdAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
        <% } %>
      </section>

      <!-- PRODUCTS -->
      <section class="card panel" id="panel-products" hidden>
        <div class="card-head"><h2 class="mono">products</h2><span class="muted"><%= products.length %> documents</span></div>
        <% if (!products.length) { %><div class="empty">No documents</div><% } else { %>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>_id</th><th>image</th><th>name</th><th>category</th><th class="right">price</th><th class="right">discountPrice</th><th class="right">stock</th><th>rating</th><th>isDeal</th><th>createdAt</th></tr></thead>
          <tbody>
            <% products.forEach(p => { %>
              <tr>
                <td class="mono id"><%= p._id %></td>
                <td><% if (p.images && p.images.length) { %><img class="thumb" src="<%= p.images[0].url %>" alt="" onerror="this.style.display='none'"><% } else { %>—<% } %></td>
                <td class="cell-main"><%= p.name %></td>
                <td><%= p.category %></td>
                <td class="right num"><%= p.price %></td>
                <td class="right num"><%= p.discountPrice || 0 %></td>
                <td class="right num" style="<%= p.stock < 5 ? 'color:var(--danger);font-weight:600' : '' %>"><%= p.stock %></td>
                <td class="num"><%= p.rating %> (<%= p.numReviews %>)</td>
                <td><%= p.isDeal %></td>
                <td class="muted"><%= formatDateTime(p.createdAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
        <% } %>
      </section>

      <!-- ORDERS -->
      <section class="card panel" id="panel-orders" hidden>
        <div class="card-head"><h2 class="mono">orders</h2><span class="muted"><%= orders.length %> documents</span></div>
        <% if (!orders.length) { %><div class="empty">No documents</div><% } else { %>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>_id</th><th>user</th><th>customerName</th><th>email</th><th>phone</th><th>items</th><th class="right">total</th><th>paymentMethod</th><th>status</th><th>createdAt</th></tr></thead>
          <tbody>
            <% orders.forEach(o => { %>
              <tr>
                <td class="mono id"><%= o._id %></td>
                <td class="mono id"><%= o.user || 'null' %></td>
                <td class="cell-main"><%= o.customerName %></td>
                <td><%= o.email %></td>
                <td><%= o.phone %></td>
                <td title="<%= o.items.map(i => i.name + ' ×' + i.quantity).join(', ') %>"><%= o.items.map(i => i.name + ' ×' + i.quantity).join(', ') %></td>
                <td class="right num"><%= o.total %></td>
                <td><%= o.paymentMethod %></td>
                <td><span class="badge badge-<%= o.status %>"><%= o.status %></span></td>
                <td class="muted"><%= formatDateTime(o.createdAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
        <% } %>
      </section>

      <!-- REVIEWS -->
      <section class="card panel" id="panel-reviews" hidden>
        <div class="card-head"><h2 class="mono">reviews</h2><span class="muted"><%= reviews.length %> documents</span></div>
        <% if (!reviews.length) { %><div class="empty">No documents</div><% } else { %>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>_id</th><th>product</th><th>user</th><th>order</th><th>name</th><th>rating</th><th>comment</th><th>createdAt</th></tr></thead>
          <tbody>
            <% reviews.forEach(r => { %>
              <tr>
                <td class="mono id"><%= r._id %></td>
                <td class="cell-main"><%= r.product ? r.product.name : '(deleted)' %></td>
                <td class="mono id"><%= r.user %></td>
                <td class="mono id"><%= r.order %></td>
                <td><%= r.name %></td>
                <td class="num"><%= r.rating %> ★</td>
                <td title="<%= r.comment %>"><%= r.comment || '—' %></td>
                <td class="muted"><%= formatDateTime(r.createdAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
        <% } %>
      </section>

      <!-- ANALYTICS -->
      <section class="card panel" id="panel-analytics" hidden>
        <div class="card-head"><h2 class="mono">analytics</h2><span class="muted">latest <%= analytics.length %> events</span></div>
        <% if (!analytics.length) { %><div class="empty">No documents</div><% } else { %>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>_id</th><th>eventType</th><th>page</th><th>productId</th><th>sessionId</th><th>userAgent</th><th>createdAt</th></tr></thead>
          <tbody>
            <% analytics.forEach(a => { %>
              <tr>
                <td class="mono id"><%= a._id %></td>
                <td><span class="badge plain <%= a.eventType === 'click' ? 'badge-brand' : a.eventType === 'purchase' ? 'badge-success' : '' %>"><%= a.eventType %></span></td>
                <td class="mono"><%= a.page %></td>
                <td class="mono id"><%= a.productId || '—' %></td>
                <td class="mono id"><%= a.sessionId %></td>
                <td class="muted" title="<%= a.userAgent %>"><%= a.userAgent %></td>
                <td class="muted"><%= formatDateTime(a.createdAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
        <% } %>
      </section>

      <!-- RELATIONSHIPS -->
      <section class="card panel" id="panel-relations" hidden>
        <div class="card-head"><h2>Relationships</h2></div>
        <div class="rel-diagram">
          <div class="entity"><h4>users</h4><ul><li class="key">_id</li><li>email</li><li>role</li></ul></div>
          <div class="arrow">← user<br>← user</div>
          <div class="entity"><h4>orders</h4><ul><li class="key">_id</li><li>user</li><li>items[].productId</li></ul></div>
          <div class="arrow">items[].productId →<br>← order</div>
          <div class="entity"><h4>products</h4><ul><li class="key">_id</li><li>rating</li><li>numReviews</li></ul></div>
          <div class="arrow">← product</div>
          <div class="entity"><h4>reviews</h4><ul><li class="key">_id</li><li>product</li><li>user</li><li>order</li></ul></div>
          <div class="arrow">← productId</div>
          <div class="entity"><h4>analytics</h4><ul><li class="key">_id</li><li>productId</li><li>sessionId</li></ul></div>
        </div>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>From</th><th>Field</th><th>To</th><th>Type</th><th>Notes</th></tr></thead>
          <tbody>
            <tr><td class="mono">orders</td><td class="mono">user</td><td class="mono">users._id</td><td>many-to-one</td><td class="muted">null for guest checkout</td></tr>
            <tr><td class="mono">orders</td><td class="mono">items[].productId</td><td class="mono">products._id</td><td>many-to-many</td><td class="muted">name and price copied at time of order</td></tr>
            <tr><td class="mono">reviews</td><td class="mono">product</td><td class="mono">products._id</td><td>many-to-one</td><td class="muted">updates products.rating and numReviews</td></tr>
            <tr><td class="mono">reviews</td><td class="mono">user</td><td class="mono">users._id</td><td>many-to-one</td><td class="muted">one review per user per product</td></tr>
            <tr><td class="mono">reviews</td><td class="mono">order</td><td class="mono">orders._id</td><td>many-to-one</td><td class="muted">order must be delivered</td></tr>
            <tr><td class="mono">analytics</td><td class="mono">productId</td><td class="mono">products._id</td><td>many-to-one</td><td class="muted">click events only</td></tr>
          </tbody>
        </table></div>
      </section>
    </div>
  </main>
</div>

<script>
  document.querySelectorAll('.collection').forEach(btn => btn.addEventListener('click', () => {
    document.querySelectorAll('.collection').forEach(b => b.classList.toggle('active', b === btn));
    document.querySelectorAll('.panel').forEach(p => { p.hidden = p.id !== 'panel-' + btn.dataset.tab; });
  }));
</script>
</body>
</html>
