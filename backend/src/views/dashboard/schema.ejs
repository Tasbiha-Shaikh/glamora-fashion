<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Database Tables — Glamora</title>
  <%- include('../partials/head') %>
  <style>
    .db-section { margin-bottom: 40px; }
    .db-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
      border-radius: 10px 10px 0 0;
      color: white;
    }
    .db-section-header h3 { font-size: 16px; letter-spacing: 0.5px; }
    .db-section-header span { font-size: 13px; opacity: 0.85; }
    .db-table-wrap { background: white; border-radius: 0 0 10px 10px; overflow-x: auto; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .db-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .db-table thead th {
      padding: 10px 14px;
      text-align: left;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 2px solid #eee;
      white-space: nowrap;
      color: #555;
      background: #f8f9fa;
    }
    .db-table tbody td {
      padding: 9px 14px;
      border-bottom: 1px solid #f0f0f0;
      color: #333;
      vertical-align: middle;
      max-width: 200px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .db-table tbody tr:hover td { background: #fafafa; }
    .db-table tbody tr:last-child td { border-bottom: none; }
    .id-cell { font-family: monospace; font-size: 11px; color: #888; }
    .badge-role-admin { background: plum; color: white; padding: 2px 8px; border-radius: 10px; font-size: 11px; }
    .badge-role-user { background: #888; color: white; padding: 2px 8px; border-radius: 10px; font-size: 11px; }
    .badge-status { color: white; padding: 2px 8px; border-radius: 10px; font-size: 11px; }
    .badge-pending { background: #f39c12; }
    .badge-processing { background: #3498db; }
    .badge-shipped { background: #9b59b6; }
    .badge-delivered { background: #27ae60; }
    .badge-cancelled { background: #e74c3c; }
    .stock-low { color: #e74c3c; font-weight: bold; }
    .stock-ok { color: #27ae60; font-weight: bold; }
    .no-data { padding: 30px; text-align: center; color: #aaa; font-size: 14px; }
    .rel-section { margin-bottom: 30px; }
    .tabs { display: flex; gap: 10px; margin-bottom: 25px; flex-wrap: wrap; }
    .tab-btn {
      padding: 8px 18px;
      border-radius: 20px;
      border: 2px solid #eee;
      background: white;
      cursor: pointer;
      font-size: 13px;
      font-weight: bold;
      transition: 0.2s;
      color: #555;
    }
    .tab-btn:hover { border-color: #4a2e56; color: #4a2e56; }
    .tab-btn.active { background: #4a2e56; color: white; border-color: #4a2e56; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .summary-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px,1fr)); gap: 15px; margin-bottom: 30px; }
    .summary-card { background: white; border-radius: 10px; padding: 16px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .summary-card .count { font-size: 28px; font-weight: bold; margin: 6px 0; }
    .summary-card p { font-size: 12px; color: #888; }
    .img-thumb { width: 36px; height: 36px; object-fit: cover; border-radius: 5px; vertical-align: middle; }
    .items-cell { font-size: 11px; color: #666; max-width: 180px; }
  </style>
</head>
<body>
<div class="dash-layout">
  <%- include('../partials/sidebar', { active: 'schema' }) %>
  <main class="dash-main">
    <%- include('../partials/topbar', { title: 'Database Tables', admin: admin }) %>

    <p style="color:#888; font-size:13px; margin-bottom:20px">
      Live data from MongoDB — all collections with real records
    </p>

    <!-- SUMMARY CARDS -->
    <div class="summary-cards">
      <div class="summary-card">
        <div class="count" style="color:#9b59b6"><%= users.length %></div>
        <p>👤 Users</p>
      </div>
      <div class="summary-card">
        <div class="count" style="color:#27ae60"><%= products.length %></div>
        <p>📦 Products</p>
      </div>
      <div class="summary-card">
        <div class="count" style="color:#e67e22"><%= orders.length %></div>
        <p>🧾 Orders</p>
      </div>
      <div class="summary-card">
        <div class="count" style="color:#e74c3c"><%= analytics.length %></div>
        <p>📊 Analytics Events</p>
      </div>
    </div>

    <!-- TABS -->
    <div class="tabs">
      <button class="tab-btn active" onclick="switchTab('users')">👤 Users (<%= users.length %>)</button>
      <button class="tab-btn" onclick="switchTab('products')">📦 Products (<%= products.length %>)</button>
      <button class="tab-btn" onclick="switchTab('orders')">🧾 Orders (<%= orders.length %>)</button>
      <button class="tab-btn" onclick="switchTab('analytics')">📊 Analytics (<%= analytics.length %>)</button>
      <button class="tab-btn" onclick="switchTab('relations')">🔗 Relationships</button>
    </div>

    <!-- ── USERS TABLE ─────────────────────────────────────────────────── -->
    <div id="tab-users" class="tab-content active">
      <div class="db-section">
        <div class="db-section-header" style="background:#9b59b6">
          <h3>👤 users — Collection</h3>
          <span><%= users.length %> documents</span>
        </div>
        <div class="db-table-wrap">
          <% if (users.length === 0) { %>
            <div class="no-data">No users found</div>
          <% } else { %>
          <table class="db-table">
            <thead>
              <tr>
                <th>_id (ObjectId)</th>
                <th>name</th>
                <th>email</th>
                <th>role</th>
                <th>avatar</th>
                <th>addresses</th>
                <th>createdAt</th>
                <th>updatedAt</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
              <tr>
                <td class="id-cell"><%= u._id.toString() %></td>
                <td><strong><%= u.name %></strong></td>
                <td><%= u.email %></td>
                <td>
                  <span class="badge-role-<%= u.role %>"><%= u.role %></span>
                </td>
                <td><%= u.avatar || '—' %></td>
                <td><%= u.addresses && u.addresses.length > 0 ? u.addresses.length + ' address(es)' : '—' %></td>
                <td><%= new Date(u.createdAt).toLocaleString() %></td>
                <td><%= new Date(u.updatedAt).toLocaleString() %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ── PRODUCTS TABLE ──────────────────────────────────────────────── -->
    <div id="tab-products" class="tab-content">
      <div class="db-section">
        <div class="db-section-header" style="background:#27ae60">
          <h3>📦 products — Collection</h3>
          <span><%= products.length %> documents</span>
        </div>
        <div class="db-table-wrap">
          <% if (products.length === 0) { %>
            <div class="no-data">No products found</div>
          <% } else { %>
          <table class="db-table">
            <thead>
              <tr>
                <th>_id (ObjectId)</th>
                <th>image</th>
                <th>name</th>
                <th>category</th>
                <th>price</th>
                <th>discountPrice</th>
                <th>brand</th>
                <th>stock</th>
                <th>rating</th>
                <th>isDeal</th>
                <th>isFeatured</th>
                <th>createdAt</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(p => { %>
              <tr>
                <td class="id-cell"><%= p._id.toString() %></td>
                <td>
                  <% if (p.images && p.images.length > 0) { %>
                    <img src="<%= p.images[0].url %>" class="img-thumb" onerror="this.style.display='none'" />
                  <% } else { %>
                    —
                  <% } %>
                </td>
                <td><strong><%= p.name %></strong></td>
                <td><%= p.category %></td>
                <td>$<%= p.price %></td>
                <td><%= p.discountPrice > 0 ? '$' + p.discountPrice : '—' %></td>
                <td><%= p.brand %></td>
                <td class="<%= p.stock < 5 ? 'stock-low' : 'stock-ok' %>">
                  <%= p.stock %> <%= p.stock < 5 ? '⚠️' : '' %>
                </td>
                <td><%= p.rating || 0 %></td>
                <td><%= p.isDeal ? '✅' : '❌' %></td>
                <td><%= p.isFeatured ? '✅' : '❌' %></td>
                <td><%= new Date(p.createdAt).toLocaleString() %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ── ORDERS TABLE ────────────────────────────────────────────────── -->
    <div id="tab-orders" class="tab-content">
      <div class="db-section">
        <div class="db-section-header" style="background:#e67e22">
          <h3>🧾 orders — Collection</h3>
          <span><%= orders.length %> documents</span>
        </div>
        <div class="db-table-wrap">
          <% if (orders.length === 0) { %>
            <div class="no-data">No orders found</div>
          <% } else { %>
          <table class="db-table">
            <thead>
              <tr>
                <th>_id (ObjectId)</th>
                <th>customerName</th>
                <th>email</th>
                <th>phone</th>
                <th>address</th>
                <th>paymentMethod</th>
                <th>items</th>
                <th>subtotal</th>
                <th>total</th>
                <th>status</th>
                <th>createdAt</th>
                <th>updatedAt</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(o => { %>
              <tr>
                <td class="id-cell"><%= o._id.toString() %></td>
                <td><strong><%= o.customerName %></strong></td>
                <td><%= o.email %></td>
                <td><%= o.phone %></td>
                <td title="<%= o.address %>"><%= o.address.substring(0, 30) %><%= o.address.length > 30 ? '...' : '' %></td>
                <td><%= o.paymentMethod.toUpperCase() %></td>
                <td class="items-cell">
                  <% o.items.forEach(item => { %>
                    <%= item.name %> x<%= item.quantity %><br/>
                  <% }) %>
                </td>
                <td>$<%= o.subtotal.toFixed(2) %></td>
                <td><strong style="color:plum">$<%= o.total.toFixed(2) %></strong></td>
                <td>
                  <span class="badge-status badge-<%= o.status %>"><%= o.status %></span>
                </td>
                <td><%= new Date(o.createdAt).toLocaleString() %></td>
                <td><%= new Date(o.updatedAt).toLocaleString() %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ── ANALYTICS TABLE ─────────────────────────────────────────────── -->
    <div id="tab-analytics" class="tab-content">
      <div class="db-section">
        <div class="db-section-header" style="background:#e74c3c">
          <h3>📊 analytics — Collection</h3>
          <span><%= analytics.length %> documents (showing latest 100)</span>
        </div>
        <div class="db-table-wrap">
          <% if (analytics.length === 0) { %>
            <div class="no-data">No analytics data yet — starts collecting when users visit the store</div>
          <% } else { %>
          <table class="db-table">
            <thead>
              <tr>
                <th>_id (ObjectId)</th>
                <th>page</th>
                <th>sessionId</th>
                <th>eventType</th>
                <th>productId (FK → products)</th>
                <th>userAgent</th>
                <th>createdAt</th>
              </tr>
            </thead>
            <tbody>
              <% analytics.forEach(a => { %>
              <tr>
                <td class="id-cell"><%= a._id.toString() %></td>
                <td><strong><%= a.page %></strong></td>
                <td class="id-cell"><%= a.sessionId %></td>
                <td>
                  <span class="badge-status" style="background:<%= a.eventType === 'pageview' ? '#3498db' : a.eventType === 'click' ? '#9b59b6' : '#27ae60' %>">
                    <%= a.eventType %>
                  </span>
                </td>
                <td class="id-cell"><%= a.productId ? a.productId.toString() : '—' %></td>
                <td title="<%= a.userAgent %>"><%= a.userAgent ? a.userAgent.substring(0, 30) + '...' : '—' %></td>
                <td><%= new Date(a.createdAt).toLocaleString() %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ── RELATIONSHIPS ───────────────────────────────────────────────── -->
    <div id="tab-relations" class="tab-content">
      <div class="chart-card">
        <h3 style="margin-bottom:20px">🔗 Collection Relationships</h3>

        <!-- ERD DIAGRAM -->
        <div style="background:#f8f9fa; border-radius:10px; padding:25px; margin-bottom:25px; overflow-x:auto">
          <div style="display:flex; align-items:center; justify-content:center; gap:30px; flex-wrap:wrap; min-width:600px">

            <!-- USERS BOX -->
            <div style="background:white; border:2px solid #9b59b6; border-radius:8px; padding:15px; min-width:150px; text-align:center">
              <div style="background:#9b59b6; color:white; padding:6px 12px; border-radius:5px; margin-bottom:10px; font-weight:bold; font-size:13px">👤 USERS</div>
              <div style="font-size:11px; color:#888; text-align:left; line-height:2">
                🔑 _id<br/>name<br/>email<br/>password<br/>role
              </div>
            </div>

            <!-- ARROW users→orders -->
            <div style="text-align:center; font-size:12px; color:#666">
              <div>1</div>
              <div style="font-size:20px">←──</div>
              <div style="font-size:10px">email match</div>
              <div>N</div>
            </div>

            <!-- ORDERS BOX -->
            <div style="background:white; border:2px solid #e67e22; border-radius:8px; padding:15px; min-width:150px; text-align:center">
              <div style="background:#e67e22; color:white; padding:6px 12px; border-radius:5px; margin-bottom:10px; font-weight:bold; font-size:13px">🧾 ORDERS</div>
              <div style="font-size:11px; color:#888; text-align:left; line-height:2">
                🔑 _id<br/>customerName<br/>🔗 email<br/>items[].productId<br/>total<br/>status
              </div>
            </div>

            <!-- ARROW orders→products -->
            <div style="text-align:center; font-size:12px; color:#666">
              <div>N</div>
              <div style="font-size:20px">──→</div>
              <div style="font-size:10px">productId</div>
              <div>1</div>
            </div>

            <!-- PRODUCTS BOX -->
            <div style="background:white; border:2px solid #27ae60; border-radius:8px; padding:15px; min-width:150px; text-align:center">
              <div style="background:#27ae60; color:white; padding:6px 12px; border-radius:5px; margin-bottom:10px; font-weight:bold; font-size:13px">📦 PRODUCTS</div>
              <div style="font-size:11px; color:#888; text-align:left; line-height:2">
                🔑 _id<br/>name<br/>category<br/>price<br/>stock
              </div>
            </div>

            <!-- ARROW analytics→products -->
            <div style="text-align:center; font-size:12px; color:#666">
              <div>N</div>
              <div style="font-size:20px">←──</div>
              <div style="font-size:10px">productId</div>
              <div>1</div>
            </div>

            <!-- ANALYTICS BOX -->
            <div style="background:white; border:2px solid #e74c3c; border-radius:8px; padding:15px; min-width:150px; text-align:center">
              <div style="background:#e74c3c; color:white; padding:6px 12px; border-radius:5px; margin-bottom:10px; font-weight:bold; font-size:13px">📊 ANALYTICS</div>
              <div style="font-size:11px; color:#888; text-align:left; line-height:2">
                🔑 _id<br/>page<br/>sessionId<br/>🔗 productId<br/>eventType
              </div>
            </div>

          </div>
        </div>

        <!-- RELATIONSHIPS TABLE -->
        <table class="dash-table">
          <thead>
            <tr><th>From Collection</th><th>Field</th><th>To Collection</th><th>Relationship Type</th><th>Description</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="badge-status" style="background:#e67e22">orders</span></td>
              <td><code>items[].productId</code></td>
              <td><span class="badge-status" style="background:#27ae60">products</span></td>
              <td>Many-to-Many</td>
              <td>An order contains many products; a product can appear in many orders</td>
            </tr>
            <tr>
              <td><span class="badge-status" style="background:#e67e22">orders</span></td>
              <td><code>email</code></td>
              <td><span class="badge-status" style="background:#9b59b6">users</span></td>
              <td>Many-to-One</td>
              <td>Many orders can belong to one user (matched via email field)</td>
            </tr>
            <tr>
              <td><span class="badge-status" style="background:#e74c3c">analytics</span></td>
              <td><code>productId</code></td>
              <td><span class="badge-status" style="background:#27ae60">products</span></td>
              <td>Many-to-One</td>
              <td>Many click events reference one product being viewed/clicked</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<script>
  function switchTab(name) {
    // Hide all tab contents
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));

    // Show selected
    document.getElementById('tab-' + name).classList.add('active');
    event.target.classList.add('active');
  }
</script>
</body>
</html>