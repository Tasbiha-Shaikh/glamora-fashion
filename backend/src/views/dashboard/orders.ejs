<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Orders — Glamora Dashboard</title>
  <%- include('../partials/head') %>
  <style>
    .toggle-btn { background:#4a2e56; color:white; border:none; padding:6px 14px; border-radius:5px; cursor:pointer; font-size:12px; white-space:nowrap; transition:0.2s; }
    .toggle-btn:hover { background:#5c3b6b; }
    .detail-row { display:none; }
    .detail-row.open { display:table-row; }
    .detail-box { background:#fdf6ff; padding:0; animation:slideDown 0.25s ease; }
    @keyframes slideDown { from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:translateY(0)} }

    /* DETAIL SECTIONS */
    .detail-sections { display:grid; gap:0; }
    .dsection { padding:20px 28px; border-bottom:1px solid #ece6f0; }
    .dsection:last-child { border-bottom:none; }
    .dsection h4 { color:#4a2e56; font-size:13px; font-weight:700; margin-bottom:14px; letter-spacing:0.3px; text-transform:uppercase; display:flex; align-items:center; gap:6px; }
    .drow { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:12px; }
    .dfield label { font-size:10px; color:#999; text-transform:uppercase; letter-spacing:0.6px; display:block; margin-bottom:3px; }
    .dfield p { color:#333; font-size:13px; font-weight:500; }
    .address-pill { background:white; border:1px solid #d8bfe8; border-left:4px solid #9b59b6; border-radius:7px; padding:10px 14px; color:#333; font-size:13px; line-height:1.7; }

    /* ITEMS TABLE */
    .items-tbl { width:100%; border-collapse:collapse; }
    .items-tbl th { padding:8px 12px; font-size:10px; text-transform:uppercase; letter-spacing:0.5px; color:#888; background:white; text-align:left; border-bottom:1px solid #eee; }
    .items-tbl td { padding:10px 12px; border-bottom:1px solid #f0eaf5; vertical-align:middle; font-size:13px; color:#333; }
    .items-tbl tr:last-child td { border-bottom:none; }
    .item-img { width:44px; height:44px; object-fit:cover; border-radius:7px; border:1px solid #e5d8f0; }
    .qty-chip { background:#ede0f5; color:#4a2e56; padding:3px 11px; border-radius:20px; font-weight:700; font-size:12px; display:inline-block; }

    /* TOTALS */
    .totals-card { background:white; border:1px solid #e0d0ea; border-radius:9px; overflow:hidden; max-width:280px; margin-left:auto; }
    .trow { display:flex; justify-content:space-between; padding:9px 16px; font-size:13px; color:#555; border-bottom:1px solid #f5f0f9; }
    .trow:last-child { border-bottom:none; font-size:15px; font-weight:700; color:#4a2e56; background:#f9f4fd; }
    .free-tag { color:#27ae60; font-weight:600; }

    /* TIMELINE */
    .timeline { display:flex; gap:20px; flex-wrap:wrap; }
    .tl-item { background:white; border:1px solid #e5d8f0; border-radius:8px; padding:10px 14px; flex:1; min-width:150px; }
    .tl-item label { font-size:10px; color:#999; text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:4px; }
    .tl-item p { font-size:12px; color:#333; font-weight:500; }
    .mono { font-family:monospace; font-size:11px; color:#888; word-break:break-all; }

    /* ORDER STATS BAR */
    .order-stats { display:flex; gap:15px; margin-bottom:20px; flex-wrap:wrap; }
    .ostat { background:white; border-radius:9px; padding:13px 18px; flex:1; min-width:120px; box-shadow:0 1px 6px rgba(0,0,0,0.06); text-align:center; }
    .ostat .num { font-size:22px; font-weight:700; }
    .ostat .lbl { font-size:11px; color:#888; margin-top:2px; }
  </style>
</head>
<body>
<div class="dash-layout">
  <%- include('../partials/sidebar', { active: 'orders' }) %>
  <main class="dash-main">
    <%- include('../partials/topbar', { title: 'All Orders', admin: admin }) %>

    <!-- QUICK STATS -->
    <div class="order-stats">
      <div class="ostat">
        <div class="num"><%= orders.length %></div>
        <div class="lbl">Total Orders</div>
      </div>
      <div class="ostat">
        <div class="num" style="color:#f39c12"><%= orders.filter(o=>o.status==='pending').length %></div>
        <div class="lbl">Pending</div>
      </div>
      <div class="ostat">
        <div class="num" style="color:#3498db"><%= orders.filter(o=>o.status==='processing').length %></div>
        <div class="lbl">Processing</div>
      </div>
      <div class="ostat">
        <div class="num" style="color:#9b59b6"><%= orders.filter(o=>o.status==='shipped').length %></div>
        <div class="lbl">Shipped</div>
      </div>
      <div class="ostat">
        <div class="num" style="color:#27ae60"><%= orders.filter(o=>o.status==='delivered').length %></div>
        <div class="lbl">Delivered</div>
      </div>
      <div class="ostat">
        <div class="num" style="color:#4a2e56">$<%= orders.reduce((s,o)=>s+o.total,0).toFixed(2) %></div>
        <div class="lbl">Total Revenue</div>
      </div>
    </div>

    <div class="chart-card">
      <table class="dash-table">
        <thead>
          <tr>
            <th>Order ID</th><th>Customer</th><th>Items</th><th>Total</th>
            <th>Payment</th><th>Date</th><th>Status</th><th>Update</th><th>Full Detail</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach((order, i) => {
            const itemSummary = order.items.map(it => it.name + ' x' + it.quantity).join(', ');
          %>
            <tr>
              <td><strong style="font-family:monospace">#<%= order._id.toString().slice(-6).toUpperCase() %></strong></td>
              <td>
                <strong><%= order.customerName %></strong><br/>
                <span style="font-size:11px;color:#aaa"><%= order.email %></span>
              </td>
              <td style="font-size:12px;color:#666;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= itemSummary %>">
                <%= order.items.length %> item<%= order.items.length!==1?'s':'' %>
                <br/><span style="font-size:11px;color:#aaa"><%= itemSummary.length > 35 ? itemSummary.substring(0,35)+'...' : itemSummary %></span>
              </td>
              <td><strong style="color:#4a2e56">$<%= order.total.toFixed(2) %></strong></td>
              <td>
                <span class="badge" style="background:<%= order.paymentMethod==='cod'?'#f39c12':'#27ae60' %>">
                  <%= order.paymentMethod.toUpperCase() %>
                </span>
              </td>
              <td style="font-size:12px">
                <%= new Date(order.createdAt).toLocaleDateString('en-PK',{month:'short',day:'numeric',year:'numeric'}) %>
              </td>
              <td><span class="badge badge-<%= order.status %>"><%= order.status %></span></td>
              <td>
                <form method="POST" action="/dashboard/orders/<%= order._id %>/status">
                  <select name="status" onchange="this.form.submit()" class="status-select">
                    <option value="pending"    <%= order.status==='pending'    ?'selected':'' %>>Pending</option>
                    <option value="processing" <%= order.status==='processing' ?'selected':'' %>>Processing</option>
                    <option value="shipped"    <%= order.status==='shipped'    ?'selected':'' %>>Shipped</option>
                    <option value="delivered"  <%= order.status==='delivered'  ?'selected':'' %>>Delivered</option>
                    <option value="cancelled"  <%= order.status==='cancelled'  ?'selected':'' %>>Cancelled</option>
                  </select>
                </form>
              </td>
              <td>
                <button class="toggle-btn" onclick="toggle('<%= order._id %>',this)">▼ View</button>
              </td>
            </tr>

            <!-- DETAIL ROW -->
            <tr class="detail-row" id="detail-<%= order._id %>">
              <td colspan="9" style="padding:0;border-bottom:3px solid #9b59b6">
                <div class="detail-box">
                  <div class="detail-sections">

                    <!-- CUSTOMER -->
                    <div class="dsection">
                      <h4>👤 Customer Information</h4>
                      <div class="drow">
                        <div class="dfield"><label>Full Name</label><p><%= order.customerName %></p></div>
                        <div class="dfield"><label>Email</label><p><%= order.email %></p></div>
                        <div class="dfield"><label>Phone</label><p><%= order.phone %></p></div>
                        <div class="dfield"><label>Payment Method</label><p><%= order.paymentMethod==='cod'?'Cash On Delivery':'Online Payment' %></p></div>
                      </div>
                    </div>

                    <!-- ADDRESS -->
                    <div class="dsection">
                      <h4>📍 Delivery Address</h4>
                      <div class="address-pill"><%= order.address %></div>
                    </div>

                    <!-- ITEMS -->
                    <div class="dsection">
                      <h4>🛍️ Ordered Items — <%= order.items.length %> item<%= order.items.length!==1?'s':'' %></h4>
                      <table class="items-tbl">
                        <thead>
                          <tr><th>Image</th><th>Product</th><th>Unit Price</th><th>Quantity</th><th>Line Total</th></tr>
                        </thead>
                        <tbody>
                          <% order.items.forEach(item => { %>
                          <tr>
                            <td>
                              <% if (item.img) { %>
                                <img src="<%= item.img %>" class="item-img" onerror="this.style.display='none'" />
                              <% } else { %>
                                <div style="width:44px;height:44px;background:#f0e8f5;border-radius:7px;display:flex;align-items:center;justify-content:center">📦</div>
                              <% } %>
                            </td>
                            <td><strong><%= item.name %></strong></td>
                            <td>$<%= item.price.toFixed(2) %></td>
                            <td><span class="qty-chip">× <%= item.quantity %></span></td>
                            <td><strong style="color:#4a2e56">$<%= (item.price*item.quantity).toFixed(2) %></strong></td>
                          </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>

                    <!-- TOTALS + TIMELINE side by side -->
                    <div class="dsection" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start">
                      <div>
                        <h4>💰 Bill Summary</h4>
                        <div class="totals-card">
                          <div class="trow"><span>Subtotal</span><span>$<%= order.subtotal.toFixed(2) %></span></div>
                          <div class="trow"><span>Delivery</span><span class="free-tag">Free ✓</span></div>
                          <div class="trow"><span>Grand Total</span><span>$<%= order.total.toFixed(2) %></span></div>
                        </div>
                      </div>
                      <div>
                        <h4>🕐 Timeline</h4>
                        <div class="timeline">
                          <div class="tl-item"><label>Order Placed</label><p><%= new Date(order.createdAt).toLocaleString() %></p></div>
                          <div class="tl-item"><label>Last Updated</label><p><%= new Date(order.updatedAt).toLocaleString() %></p></div>
                          <div class="tl-item"><label>Order ID</label><p class="mono"><%= order._id %></p></div>
                          <div class="tl-item"><label>Status</label><p><span class="badge badge-<%= order.status %>"><%= order.status.toUpperCase() %></span></p></div>
                        </div>
                      </div>
                    </div>

                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<script>
  function toggle(id, btn) {
    const row = document.getElementById('detail-' + id);
    const isOpen = row.classList.contains('open');
    document.querySelectorAll('.detail-row.open').forEach(r => r.classList.remove('open'));
    document.querySelectorAll('.toggle-btn').forEach(b => b.textContent = '▼ View');
    if (!isOpen) { row.classList.add('open'); btn.textContent = '▲ Hide'; btn.scrollIntoView({behavior:'smooth',block:'nearest'}); }
  }
</script>
</body>
</html>