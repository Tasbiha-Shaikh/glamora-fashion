<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Customers · Glamora Admin</title>
  <%- include('../partials/head') %>
  <style>
    .toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .toolbar .search { flex: 1; min-width: 220px; max-width: 340px; }
    .toolbar .tabs { background: var(--surface-muted); border: 1px solid var(--border); border-radius: var(--radius); padding: 3px; }
    .user-cell { display: flex; align-items: center; gap: 12px; }
    .actions { display: flex; justify-content: flex-end; gap: 2px; }
    tr.is-hidden { display: none; }
    .stack-form { display: flex; flex-direction: column; gap: 14px; }
  </style>
</head>
<body>
<% const admins = users.filter(u => u.role === 'admin').length; %>
<div class="dash-layout">
  <%- include('../partials/sidebar', { active: 'users' }) %>
  <main class="dash-main">
    <div class="page">
      <%- include('../partials/topbar', {
        title: 'Customers',
        subtitle: users.length + ' account' + (users.length !== 1 ? 's' : '') + ' · ' + newUsersToday + ' joined today',
        admin: admin,
      }) %>

      <% if (typeof successMsg !== 'undefined' && successMsg) { %>
        <div class="alert alert-success" role="status"><%= successMsg %></div>
      <% } %>
      <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div class="alert alert-error" role="alert"><%= errorMsg %></div>
      <% } %>

      <div class="toolbar">
        <label class="search">
          <span class="sr-only">Search customers</span>
          <%- icon('search', 15) %>
          <input class="input" id="userSearch" type="search" placeholder="Search by name or email">
        </label>
        <div class="tabs" role="tablist" aria-label="Filter by role">
          <button class="tab active" data-role="all">All <span class="count"><%= users.length %></span></button>
          <button class="tab" data-role="user">Customers <span class="count"><%= users.length - admins %></span></button>
          <button class="tab" data-role="admin">Admins <span class="count"><%= admins %></span></button>
        </div>
      </div>

      <div class="card">
        <% if (users.length === 0) { %>
          <div class="empty"><%- icon('users', 30) %><strong>No accounts yet</strong>Customers appear here after they register.</div>
        <% } else { %>
        <div class="table-wrap">
          <table class="table" id="userTable">
            <thead>
              <tr><th>Name</th><th>Role</th><th>Joined</th><th><span class="sr-only">Actions</span></th></tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
              <tr data-search="<%= (u.name + ' ' + u.email).toLowerCase() %>" data-role="<%= u.role %>">
                <td>
                  <div class="user-cell">
                    <div class="avatar"><%= u.name.charAt(0).toUpperCase() %></div>
                    <div>
                      <div class="cell-main"><%= u.name %></div>
                      <div class="cell-sub"><%= u.email %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <% if (u.role === 'admin') { %>
                    <span class="badge badge-brand plain">Admin</span>
                  <% } else { %>
                    <span class="badge plain">Customer</span>
                  <% } %>
                </td>
                <td class="muted"><%= formatDate(u.createdAt) %></td>
                <td>
                  <div class="actions">
                    <button type="button" class="icon-btn" title="Edit" aria-label="Edit <%= u.name %>"
                      data-edit="<%= JSON.stringify({ id: u._id, name: u.name, email: u.email, role: u.role }) %>"><%- icon('edit', 16) %></button>
                    <button type="button" class="icon-btn danger" title="Delete" aria-label="Delete <%= u.name %>"
                      data-delete="<%= u._id %>" data-delete-name="<%= u.name %>"><%- icon('trash', 16) %></button>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <div class="empty" id="noUsers" style="display:none"><strong>No matching accounts</strong>Try another search.</div>
        </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<!-- EDIT -->
<div class="modal-overlay" id="editModal" role="dialog" aria-modal="true" aria-labelledby="editTitle">
  <form class="modal sm" method="POST" id="editForm">
    <div class="modal-header">
      <h3 id="editTitle">Edit account</h3>
      <button class="icon-btn" type="button" data-close aria-label="Close"><%- icon('close', 18) %></button>
    </div>
    <div class="modal-body stack-form">
      <div class="field">
        <label for="editName">Full name</label>
        <input class="input" type="text" name="name" id="editName" required>
      </div>
      <div class="field">
        <label for="editEmail">Email</label>
        <input class="input" type="email" name="email" id="editEmail" required>
      </div>
      <div class="field">
        <label for="editRole">Role</label>
        <select class="select" name="role" id="editRole">
          <option value="user">Customer</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <div class="field">
        <label for="editPassword">New password <span class="hint">leave empty to keep the current one</span></label>
        <input class="input" type="password" name="password" id="editPassword" minlength="6" autocomplete="new-password">
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn" data-close>Cancel</button>
      <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
  </form>
</div>

<!-- DELETE -->
<div class="modal-overlay" id="deleteModal" role="alertdialog" aria-modal="true" aria-labelledby="deleteTitle">
  <div class="modal sm">
    <div class="modal-header">
      <h3 id="deleteTitle">Delete account?</h3>
      <button class="icon-btn" type="button" data-close aria-label="Close"><%- icon('close', 18) %></button>
    </div>
    <div class="modal-body">
      <p><strong id="deleteName"></strong> will lose access to their account. Their past orders stay in the system. This can't be undone.</p>
    </div>
    <form class="modal-footer" method="POST" id="deleteForm">
      <button class="btn" type="button" data-close>Cancel</button>
      <button class="btn btn-danger" type="submit">Delete account</button>
    </form>
  </div>
</div>

<script>
(function () {
  const $ = id => document.getElementById(id);
  const open = m => m.classList.add('open');
  const close = m => m.classList.remove('open');
  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', e => {
      if (e.target === overlay || e.target.closest('[data-close]')) close(overlay);
    });
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(close);
  });

  // Filters
  const rows = Array.from(document.querySelectorAll('#userTable tbody tr'));
  let role = 'all';
  function applyFilters() {
    const q = $('userSearch').value.trim().toLowerCase();
    let visible = 0;
    rows.forEach(row => {
      const show = (!q || row.dataset.search.includes(q)) && (role === 'all' || row.dataset.role === role);
      row.classList.toggle('is-hidden', !show);
      if (show) visible++;
    });
    if ($('noUsers')) $('noUsers').style.display = visible ? 'none' : 'block';
  }
  $('userSearch').addEventListener('input', applyFilters);
  document.querySelectorAll('.tab[data-role]').forEach(tab => tab.addEventListener('click', () => {
    document.querySelectorAll('.tab[data-role]').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    role = tab.dataset.role;
    applyFilters();
  }));

  // Edit — values come from a data attribute, never inline JS, so names can't inject code
  document.querySelectorAll('[data-edit]').forEach(btn => btn.addEventListener('click', () => {
    const u = JSON.parse(btn.dataset.edit);
    $('editName').value = u.name;
    $('editEmail').value = u.email;
    $('editRole').value = u.role;
    $('editPassword').value = '';
    $('editForm').action = '/dashboard/users/' + encodeURIComponent(u.id) + '/edit';
    open($('editModal'));
  }));

  // Delete
  document.querySelectorAll('[data-delete]').forEach(btn => btn.addEventListener('click', () => {
    $('deleteName').textContent = btn.dataset.deleteName;
    $('deleteForm').action = '/dashboard/users/' + encodeURIComponent(btn.dataset.delete) + '/delete';
    open($('deleteModal'));
  }));
})();
</script>
</body>
</html>
