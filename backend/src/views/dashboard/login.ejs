<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Glamora — Dashboard Login</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
    body { background: #4a2e56; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .login-box { background: white; border-radius: 16px; padding: 40px; width: 380px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
    .login-header { text-align: center; margin-bottom: 30px; }
    .login-header h1 { color: #4a2e56; font-size: 28px; letter-spacing: 2px; }
    .login-header p { color: #888; font-size: 12px; letter-spacing: 3px; margin-top: 5px; }
    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 7px; color: #333; }
    .form-group input { width: 100%; padding: 12px 15px; border: 1.5px solid #eee; border-radius: 8px; font-size: 15px; transition: 0.3s; }
    .form-group input:focus { outline: none; border-color: #4a2e56; }
    .btn { width: 100%; padding: 14px; background: #4a2e56; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; margin-top: 5px; }
    .btn:hover { background: #5c3b6b; }
    .error { background: #fdf0ef; color: #e74c3c; border: 1px solid #e74c3c; border-radius: 6px; padding: 10px; text-align: center; margin-bottom: 15px; font-size: 13px; }
    .back-link { text-align: center; margin-top: 20px; font-size: 13px; }
    .back-link a { color: #888; }
  </style>
</head>
<body>
  <div class="login-box">
    <div class="login-header">
      <h1>GLAMORA</h1>
      <p>ADMIN DASHBOARD</p>
    </div>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/dashboard/login">
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" placeholder="admin@gmail.com" required />
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="••••••••" required />
      </div>
      <button type="submit" class="btn">Sign In</button>
    </form>
    <div class="back-link"><a href="/">← Back to Store</a></div>
  </div>
</body>
</html>