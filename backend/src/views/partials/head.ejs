<style>
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
  body { background: #f5f5f5; }

  /* LAYOUT */
  .dash-layout { display: flex; min-height: 100vh; }

  /* SIDEBAR */
  .dash-sidebar { width: 230px; background: #4a2e56; min-height: 100vh; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
  .sidebar-logo { padding: 25px 20px; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .sidebar-logo h2 { color: white; font-size: 20px; letter-spacing: 2px; }
  .sidebar-logo p { color: rgba(255,255,255,0.5); font-size: 11px; letter-spacing: 3px; margin-top: 3px; }
  .sidebar-menu { list-style: none; padding: 15px 0; }
  .sidebar-menu li a { display: flex; align-items: center; gap: 10px; padding: 13px 20px; color: rgba(255,255,255,0.7); text-decoration: none; font-size: 14px; transition: 0.2s; }
  .sidebar-menu li a:hover, .sidebar-menu li.active a { background: rgba(255,255,255,0.15); color: white; border-left: 3px solid white; }
  .sidebar-menu li.logout a { color: rgba(255,100,100,0.8); }
  .sidebar-menu li.logout a:hover { background: rgba(255,0,0,0.1); color: #ff6b6b; }

  /* MAIN */
  .dash-main { flex: 1; padding: 25px; overflow-y: auto; }

  /* TOPBAR */
  .dash-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid #eee; }
  .dash-topbar h1 { color: #333; font-size: 24px; }
  .admin-info { display: flex; align-items: center; gap: 10px; }
  .admin-bubble { width: 38px; height: 38px; background: #4a2e56; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; }
  .admin-info p { font-size: 13px; color: #666; }

  /* LIVE BANNER */
  .live-banner { background: #27ae60; color: white; padding: 12px 20px; border-radius: 8px; margin-bottom: 25px; display: flex; align-items: center; font-size: 14px; }
  .live-dot { width: 10px; height: 10px; background: #90ee90; border-radius: 50%; margin-right: 10px; animation: pulse 1.5s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

  /* STAT GRID */
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; margin-bottom: 25px; }
  .stat-card { background: white; border-radius: 10px; padding: 18px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
  .stat-icon { width: 46px; height: 46px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
  .stat-card p { color: #888; font-size: 12px; margin-bottom: 4px; }
  .stat-card h2 { color: #333; font-size: 22px; }
  .stat-card.purple .stat-icon { background: #f5eef8; }
  .stat-card.green .stat-icon { background: #eafaf1; }
  .stat-card.orange .stat-icon { background: #fef9e7; }
  .stat-card.blue .stat-icon { background: #e8f4fd; }
  .stat-card.teal .stat-icon { background: #e8f8f5; }
  .stat-card.pink .stat-icon { background: #fdeef4; }
  .stat-card.red .stat-icon { background: #fdf0ef; }
  .stat-card.dark .stat-icon { background: #eaecee; }

  /* CHART CARDS */
  .charts-row { display: flex; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
  .chart-card { background: white; border-radius: 10px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); flex: 1; min-width: 280px; overflow-x: auto; }
  .chart-card.wide { flex: 2; }
  .chart-card h3 { color: #333; font-size: 16px; margin-bottom: 15px; }
  .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
  .card-header a { color: plum; font-size: 13px; text-decoration: none; }

  /* TABLES */
  .dash-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .dash-table th { padding: 10px 12px; background: #f8f9fa; color: #666; text-align: left; font-size: 12px; border-bottom: 2px solid #eee; }
  .dash-table td { padding: 10px 12px; border-bottom: 1px solid #f0f0f0; color: #333; vertical-align: middle; }
  .dash-table tr:hover td { background: #fafafa; }
  .mini-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .mini-table th { padding: 8px; background: #f8f9fa; color: #666; text-align: left; font-size: 12px; }
  .mini-table td { padding: 8px; border-bottom: 1px solid #f0f0f0; color: #333; }

  /* BADGES */
  .badge { color: white; font-size: 11px; font-weight: bold; padding: 3px 9px; border-radius: 20px; text-transform: capitalize; }
  .badge-pending { background: #f39c12; }
  .badge-processing { background: #3498db; }
  .badge-shipped { background: #9b59b6; }
  .badge-delivered { background: #27ae60; }
  .badge-cancelled { background: #e74c3c; }

  /* USER AVATAR */
  .user-avatar { width: 34px; height: 34px; background: plum; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 14px; }

  /* PRODUCT ROW */
  .product-row { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid #f0f0f0; }
  .product-row img { width: 42px; height: 42px; object-fit: cover; border-radius: 6px; }
  .product-row p { font-size: 13px; color: #333; }
  .product-row p:last-child { color: #888; font-size: 12px; }

  /* STATUS SELECT */
  .status-select { padding: 5px 8px; border: 1px solid #eee; border-radius: 4px; font-size: 12px; }

  /* SCHEMA */
  .schema-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
  .schema-table { background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
  .schema-header { padding: 15px 18px; display: flex; justify-content: space-between; align-items: center; }
  .schema-header h3 { font-size: 16px; }
  .schema-header span { font-size: 11px; background: rgba(0,0,0,0.08); padding: 3px 8px; border-radius: 10px; color: #666; }
  .schema-table table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .schema-table th { padding: 8px 12px; background: #fafafa; color: #666; text-align: left; font-size: 11px; text-transform: uppercase; border-bottom: 1px solid #eee; }
  .schema-table td { padding: 8px 12px; border-bottom: 1px solid #f5f5f5; color: #333; font-size: 12px; }
  .pk-row td { background: #fffbf0; }
  .pk-row td:first-child { font-weight: bold; color: #e67e22; }
  .fk-row td:first-child { color: #3498db; }
</style>