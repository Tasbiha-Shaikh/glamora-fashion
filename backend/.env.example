# BACKEND ENVIRONMENT VARIABLES
NODE_ENV=development
PORT=5000

# Cloud MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/fashionstore for local dev)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/fashionstore?retryWrites=true&w=majority

# JWT & Session Secrets
JWT_SECRET=fashionstore_super_secret_jwt_key_2026
SESSION_SECRET=fashionstore_super_secret_session_key_2026

# Supabase (Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_BUCKET=glamora

# Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key

# Frontend URL
CLIENT_URL=http://localhost:3000

